<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.OASIS" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- background & Text -->
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="colorControlNormal">@color/hint</item>
        <item name="android:textColor">@color/text</item>

        <!-- system bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>

        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.OASIS</item>

        <!-- font -->
        <item name="fontFamily">@font/jetbrainsmono</item>
        <item name="android:fontFamily">@font/jetbrainsmono</item>
    </style>

    <!-- страницы левого меню выезжают слева -->
    <style name="Theme.OASIS.Side">
        <item name="android:windowAnimationStyle">@style/SideAnimation</item>
    </style>

    <style name="SideAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/slide_in_left</item>
        <item name="android:activityOpenExitAnimation">@anim/stay</item>
        <item name="android:activityCloseEnterAnimation">@anim/stay</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_left</item>
    </style>
</resources>